{
  "name": "@edgewarn/web-utils",
  "version": "2026.11.8-alpha.1",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "packages/core/dist",
    "packages/decoders/dist",
    "packages/core/README.md",
    "packages/decoders/README.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "packages/alerts/dist",
    "packages/alerts/README.md",
    "packages/met/dist",
    "packages/met/README.md"
  ],
  "exports": {
    ".": {
      "types": "./packages/decoders/dist/index.d.ts",
      "default": "./packages/decoders/dist/index.js"
    },
    "./geo": {
      "types": "./packages/core/dist/geo/index.d.ts",
      "default": "./packages/core/dist/geo/index.js"
    },
    "./time": {
      "types": "./packages/core/dist/time/index.d.ts",
      "default": "./packages/core/dist/time/index.js"
    },
    "./net": {
      "types": "./packages/core/dist/net/index.d.ts",
      "default": "./packages/core/dist/net/index.js"
    },
    "./grib2": {
      "types": "./packages/decoders/dist/grib2/index.d.ts",
      "default": "./packages/decoders/dist/grib2/index.js"
    },
    "./nexrad": {
      "types": "./packages/decoders/dist/nexrad/index.d.ts",
      "default": "./packages/decoders/dist/nexrad/index.js"
    },
    "./goes": {
      "types": "./packages/decoders/dist/goes/index.d.ts",
      "default": "./packages/decoders/dist/goes/index.js"
    },
    "./package.json": "./package.json",
    "./alerts": {
      "types": "./packages/alerts/dist/index.d.ts",
      "default": "./packages/alerts/dist/index.js"
    },
    "./alerts/nws": {
      "types": "./packages/alerts/dist/nws/index.d.ts",
      "default": "./packages/alerts/dist/nws/index.js"
    },
    "./met": {
      "types": "./packages/met/dist/index.d.ts",
      "default": "./packages/met/dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --test packages/core/test/*.test.mjs packages/decoders/test/*.test.mjs packages/decoders/test/models/*.test.mjs packages/alerts/test/*.test.mjs packages/met/test/*.test.mjs",
    "lint:pack": "publint --pack=false",
    "changeset": "changeset",
    "release": "npm publish",
    "check:package": "bash scripts/verify-package.sh",
    "test:time": "TZ=UTC node --test packages/core/test/time-lock.test.mjs packages/core/test/timestamp.test.mjs packages/alerts/test/alert-format.test.mjs && TZ=America/New_York node --test packages/core/test/time-lock.test.mjs packages/core/test/timestamp.test.mjs packages/alerts/test/alert-format.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@types/geojson": "7946.0.16"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "publint": "^0.3",
    "@changesets/cli": "^2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
