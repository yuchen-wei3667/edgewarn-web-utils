{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        // DOM lib is deliberate: the code targets browsers and workers (fetch, AbortSignal,
        // DecompressionStream, ReadableStream). Dropping it breaks the build; node types do not substitute.
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["geojson"],
        "strict": true,
        "composite": true,
        "declaration": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "rewriteRelativeImportExtensions": true
    }
}
