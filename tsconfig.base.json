{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["geojson"],
        "strict": true,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "rewriteRelativeImportExtensions": true
    }
}
